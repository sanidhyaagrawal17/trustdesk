# TrustDesk Environment Configuration
# Technical demonstration on synthetic data - not a regulated banking system.

# Channel Security - Server-validated Bearer secret (no default in code)
TRUSTED_CHANNEL_SECRET=

# Live Model Evaluation (Optional; Mock client used by default)
LIVE_LLM_PROVIDER=
LIVE_LLM_API_KEY=

# Dual-Mode Storage Adapters (Falls back to SQLite and in-memory dictionary if unset)
REDIS_URL=
DATABASE_URL=
